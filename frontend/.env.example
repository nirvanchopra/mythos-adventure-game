# Mythos Frontend Environment Configuration
# Copy this file to .env or .env.production

# Backend REST API URL
# In local development: /api (proxied by Vite)
# In production on Render: https://mythos-backend.onrender.com/api
VITE_API_BASE_URL=/api

# Backend WebSocket URL
# In local development: leave empty to use current host (ws://localhost:5173/ws)
# In production on Render: wss://mythos-backend.onrender.com/ws
VITE_WS_BASE_URL=
