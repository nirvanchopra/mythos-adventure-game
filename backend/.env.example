# Mythos Backend Environment Configuration
# Copy this file to .env and adjust values for your environment

# Neon PostgreSQL Database Connection URL (Required)
# Example: postgresql://<USER>:<PASSWORD>@<HOST>/<DBNAME>?sslmode=require
DATABASE_URL=postgresql://your_db_user:your_db_password@ep-your-host.neon.tech/adventure_game?sslmode=require

# Groq API Key for AI Story Generation (Optional - Procedural fallback will activate if empty)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Authentication Secret Key (Required in Production)
JWT_SECRET_KEY=mythos-super-secret-jwt-key-adventure-rpg-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Routing Prefix
API_PREFIX=/api

# Allowed CORS Origins (comma separated, or * for open dev)
Allowed_origins=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,*

# Debug Mode
DEBUG=false
